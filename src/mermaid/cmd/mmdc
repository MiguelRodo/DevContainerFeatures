#!/usr/bin/env bash
set -e

DEFAULT_USERNAME="mermaiduser"
DEFAULT_CONFIG="/usr/local/share/mermaid-config/puppeteer-config.json"

USERNAME="$DEFAULT_USERNAME"
CONFIG_FILE="$DEFAULT_CONFIG"
EXPLICIT_USERNAME=false

print_help() {
    cat <<USAGE
Usage: mermaid-mmdc [options] -- [mmdc args]

Options:
  --username=USER      Run as this user (root default: $DEFAULT_USERNAME)
  --config=FILE        Puppeteer config file (default: $DEFAULT_CONFIG)
  --help               Show this help message

Examples:
  mermaid-mmdc -i input.mmd -o output.png
  mermaid-mmdc --username=anotheruser -- -i input.mmd -o output.png

Root uses 'su' to run mmdc as USER.
Non-root runs as the current user unless --username requests another user.
Switching to another user requires passwordless 'sudo'.
USAGE
}

# Parse options
while [ $# -gt 0 ]; do
    case "$1" in
        --username=*)
            USERNAME="${1#*=}"
            EXPLICIT_USERNAME=true
            shift
            ;;
        --config=*)
            CONFIG_FILE="${1#*=}"
            shift
            ;;
        --help)
            print_help
            exit 0
            ;;
        --)
            shift
            break
            ;;
        -*)
            # Unrecognized option, stop parsing
            break
            ;;
        *)
            # Positional argument, stop parsing
            break
            ;;
    esac
done

# 🛡️ Sentinel: Prevent option injection and command injection in user-supplied commands
if ! echo "$USERNAME" | grep -Eq '^[a-zA-Z0-9_][a-zA-Z0-9_-]*$'; then
    echo "Error: Invalid USERNAME. Must consist of alphanumeric characters, dashes, and underscores, and cannot start with a dash."
    exit 1
fi

# Ensure mmdc is installed
if ! command -v mmdc &>/dev/null; then
    echo "Error: 'mmdc' command not found."
    exit 1
fi

# Execute the command as the specified user
if [ "$EUID" -eq 0 ]; then
    # Running as root
   su -s /bin/bash "$USERNAME" -c 'exec mmdc -p "$0" "$@"' -- "$CONFIG_FILE" "$@"
else
    # An ordinary user can render directly; only an explicit user switch needs sudo.
    if [ "$EXPLICIT_USERNAME" = false ] || [ "$(id -un)" = "$USERNAME" ]; then
        export PUPPETEER_CACHE_DIR="/home/$USERNAME/.cache/puppeteer"
        exec mmdc -p "$CONFIG_FILE" "$@"
    elif command -v sudo >/dev/null 2>&1; then
        exec sudo -n -u "$USERNAME" -- mmdc -p "$CONFIG_FILE" "$@"
    else
        echo "Error: 'sudo' is required to switch to $USERNAME." >&2
        exit 1
    fi
fi